# Copy to .env and fill in values for real email delivery.
# Without these, request alerts are logged to the console only.

FLASK_SECRET_KEY=change-me-in-production
# Optional dedicated Fernet material (defaults to SHA256 of FLASK_SECRET_KEY)
# FERNET_KEY=another-long-random-string

FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DASHBOARD_URL=http://127.0.0.1:3000

SESSION_TTL_HOURS=8
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SEC=300

ADMIN_NOTIFY_EMAIL=admin@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
